# Notion API 配置
# 1. 前往 https://www.notion.so/my-integrations 创建集成
# 2. 复制生成的 API 密钥（以 secret_ 开头）
# 3. 将数据库与集成共享
NOTION_API_KEY=secret_your_api_key_here
NOTION_DATABASE_ID=your_database_id_here
# 学习资源数据库 ID（可选）：复用上面的 NOTION_API_KEY，
# 需在 Notion 中把该数据库也「连接」到同一个集成；未配置时「学习资源」页显示为空，不影响其它功能
NOTION_RESOURCES_DATABASE_ID=your_resources_database_id_here

# Supabase 配置（用于阅读量和点赞统计）
# 前往 Supabase 项目设置获取以下值
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
